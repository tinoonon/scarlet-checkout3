# Cadastre estas variáveis em Vercel > Project > Settings > Environment Variables
PROFANUS_API_KEY=profanus_live_xxxxxxxx
# Opcional (Dashboard Profanus > Integracoes > Webhooks). Se definido, o webhook valida a assinatura HMAC.
PROFANUS_WEBHOOK_SECRET=
# Opcional: URpública do site (ex: https://seu-dominio.com). Se vazio, usa o host da requisição.
PUBLIC_URL=

# Token da API do Utmify (Utmify > Integracoes > Credenciais de API). Sem ele as vendas nao chegam ao Utmify.
UTMIFY_API_TOKEN=
# Opcional: nome do produto que aparece no Utmify.
UTMIFY_PRODUCT_NAME=
